{
  "name": "@backcrew/xero-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Xero Accounting API, built by BackCrew.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backcrew-xero-mcp": "dist/index.js"
  },
  "files": [
