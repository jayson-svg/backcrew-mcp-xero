# Xero Accounting API credentials.
#
# Xero uses OAuth 2.0. This repo supports two ways to authenticate,
# controlled by XERO_AUTH_MODE below. Pick ONE.
#
# ── Option A: authorization_code (default, free, most common) ──────────────
# The standard OAuth consent flow. Free on any Xero plan, but requires a
# one-time browser-based authorization step to get your first token pair
# (see README setup steps) and produces a refresh token that ROTATES on
# every use (see the note further down).
XERO_AUTH_MODE=authorization_code
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=
XERO_REFRESH_TOKEN=

# ── Option B: client_credentials (Xero "Custom Connection", paid add-on) ───
# Xero sells a premium "Custom Connection" app type that skips the browser
# consent step entirely: no redirect, no refresh token to manage, just your
# Client ID/Secret re-requesting a token directly. It costs extra on your
# Xero plan and is locked to a single organisation (so XERO_TENANT_ID isn't
# needed in this mode). If you have one, set:
#   XERO_AUTH_MODE=client_credentials
#   XERO_CLIENT_ID=
#   XERO_CLIENT_SECRET=
#   XERO_SCOPES=accounting.contacts accounting.transactions accounting.settings.read offline_access
# and leave XERO_TENANT_ID / XERO_ACCESS_TOKEN / XERO_REFRESH_TOKEN blank.
XERO_SCOPES=

# IMPORTANT (authorization_code mode only): Xero refresh tokens rotate —
# every time this server uses your refresh token to get a new access token,
# Xero issues a *new* refresh token and invalidates the old one. This server
# refreshes automatically in memory during a run, but does NOT write the new
# refresh token back to this file. If you restart the server after it has
# run long enough to trigger a refresh, update XERO_REFRESH_TOKEN with the
# latest value (logged to stderr on refresh) before restarting, or the old
# one will no longer work. Unused refresh tokens also expire after 60 days
# of inactivity, at which point you need to redo the consent flow. See
# README.

# --- Safety settings ---
# This server ships read-only by default. Nothing it does can change your
# Xero data until you deliberately turn that off.

# read_only  (default, shown below) — only look-ups are exposed.
# read_write — allows write actions, scoped by XERO_MCP_PROFILE below.
XERO_MCP_MODE=read_only

# Only matters when XERO_MCP_MODE=read_write.
#   readonly-owner — look-ups only (same as read_only mode)
#   office-ops     — everyday work: create/update contacts and sales
#                    invoices, email an invoice, record a customer payment,
#                    record money received directly into a bank account.
#                    No deletes/voids, no bills, no money going out.
#   admin          — everything, including deletes/voids and anything that
#                    represents money leaving the business: bills (AP
#                    invoices), paying a bill, and recording a direct bank
#                    spend.
XERO_MCP_PROFILE=readonly-owner
